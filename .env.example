# Copiar a .env y completar con valores propios del entorno local.
# Generar SECRET_KEY con el comando documentado en README.md.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://aprendo:CAMBIAR_CONTRASENA@127.0.0.1:5432/aprendo
SITE_URL=http://localhost:8000

# Correo de desarrollo. Completar SMTP cuando se configure ese entorno.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=webmaster@localhost
